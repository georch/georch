---
import '../css/main.css';
import { Font } from 'astro:assets';
import Icon from '../components/Icon.astro';

const title = 'Jorge Valdez @georch | Co-founder of Octahedroid, living in Guadalajara, Mexico';
const description = 'Jorge Valdez is co-founder of Octahedroid, a consulting agency specializing in modern web technology, front-end tools, cloud native architectures, automation and CMS integrations.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const links = [
  { label: 'X', icon: 'x', href: 'https://x.com/georch', text: '@georch', me: true },
  { label: 'GitHub', icon: 'github', href: 'https://github.com/georch', text: 'georch', me: true },
  { label: 'LinkedIn', icon: 'linkedin', href: 'https://www.linkedin.com/in/georch', text: 'Jorge Valdez', me: true },
  { label: 'Website', icon: 'world', href: 'https://www.octahedroid.com', text: 'octahedroid.com', me: false },
] as const;
---
<!doctype html>
<html lang="en" class="bg-beige text-negro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Jorge Valdez" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@georch" />
    <Font cssVariable="--font-imprima" preload />
  </head>
  <body class="min-h-dvh flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-xl px-6 sm:px-10 bg-arena border border-negro/20 rounded-md">
      <header class="py-8">
        <h1 class="text-center text-gris text-6xl font-serif drop-shadow-[0_1px_1px_rgba(255,255,255,1)]">Jorge Valdez</h1>
      </header>

      <main>
        <p>I'm co-founder of Octahedroid, a professional services and consulting agency specializing in modern web technology services, front-end tools, cloud native architectures, automation and CMS integrations.</p>

        <ul>
          {links.map(({ label, icon, href, text, me }) => (
            <li class="mb-4 flex items-center gap-3">
              <Icon name={icon} class="size-6 shrink-0 text-gris" />
              <span>{label}: <a href={href} rel={me ? 'me' : undefined}>{text}</a></span>
            </li>
          ))}
        </ul>
      </main>

      <footer class="py-8 text-center text-gris text-xl font-serif">
        Guadalajara, Mexico {new Date().getFullYear()}.
      </footer>
    </div>
  </body>
</html>
